// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  name            String?
  photo           String?
  email           String    @unique
  phone           String?
  password        String    @default("")
  isEmailVerified Boolean   @default(false)
  isDeleted       Boolean   @default(false)
  lang            Lang      @default(ENG)
  role            Role      @default(CUSTOMER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  dob             DateTime?
  fcmToken        String?   @default("")
  isGoogleAuth    Boolean   @default(false)
  lastLogin       DateTime?
  lastSeen        DateTime? @default(now())

  // Existing relations
  profile Profile?
  brand   Brand?   @relation(fields: [brandId], references: [id])
  brandId String?  @db.ObjectId

  carts        Cart[]
  products     Product[]
  wishlists    Wishlist[]
  orders       Order[]
  reviews      Review[]
  payments     Payment[]
  EventBooking EventBooking[]
  Visitor      Visitor[]
  Blog         Blog[]

  @@map("users")
}

model Otp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  verified  Boolean  @default(false)

  @@map("otp")
}

model Profile {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @unique @db.ObjectId
  intro      String?  @default("")
  fullName   String?
  bloodGroup String?
  gender     Gender?
  zip        String?
  city       String?
  state      String?
  address    String?
  country    String?
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
  @@map("profile")
}

// Enums
enum Role {
  ADMIN
  CUSTOMER
}

enum Lang {
  ENG
  ARB
}

enum Gender {
  Male
  Female
  Others
}

model Visitor {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String  @unique
  userId    String? @db.ObjectId
  user      User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("visitors")
}

model Brand {
  id   String  @id @default(auto()) @map("_id") @db.ObjectId
  name String
  des  String?
  img  String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  users     User[]
  products  Product[]

  @@map("brands")
}

model Category {
  id   String  @id @default(auto()) @map("_id") @db.ObjectId
  name String
  des  String?
  img  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("categories")
}

model Size {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("size")
}

model Product {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  shortDes        String
  des             String?
  images          String[]
  sizeId          String   @db.ObjectId
  categoryId      String   @db.ObjectId
  brandId         String   @db.ObjectId
  tag             String?
  price           String
  discount        Boolean  @default(false)
  discountPercent String   @default("0")
  shippingFee     String   @default("0")
  stock           Boolean  @default(true)
  quantity        String
  creatorId       String   @db.ObjectId

  category Category @relation(fields: [categoryId], references: [id])
  brand    Brand    @relation(fields: [brandId], references: [id])
  creator  User     @relation(fields: [creatorId], references: [id])

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  carts         Cart[]
  wishlists     Wishlist[]
  orderProducts OrderProduct[]
  reviews       Review[]
  Size          Size?          @relation(fields: [sizeId], references: [id])

  @@map("products")
}

model Cart {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  productId String  @db.ObjectId
  userId    String  @db.ObjectId
  quantity  String  @default("1")
  user      User    @relation(fields: [userId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carts")
}

model Wishlist {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  productId String @db.ObjectId
  userId    String @db.ObjectId

  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wishlists")
}

model Payment {
  id                    String        @id @default(auto()) @map("_id") @db.ObjectId
  userId                String        @db.ObjectId
  orderId               String?       @db.ObjectId
  eventBookingId        String?       @db.ObjectId // Make this UNIQUE
  order                 Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?
  transactionId         String?
  name                  String?
  amount                Float
  paidAmount            Float?        @default(0)
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)
  method                PaymentMethod @default(CARD)
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventBooking EventBooking?

  @@index([orderId])
  @@index([userId])
  @@map("payments")
}

// Update Order model
model Order {
  id      String      @id @default(auto()) @map("_id") @db.ObjectId
  orderNo String      @unique
  status  OrderStatus @default(PENDING)

  // User relation
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.ObjectId

  orderProducts OrderProduct[]

  // Customer details
  name    String
  email   String
  phone   String
  address String
  city    String?
  state   String?
  country String?
  zipCode String?

  // Payment info
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  amount        Float
  currency      String        @default("usd")
  payments      Payment[]

  // Shipping info
  shippingFee       Float?    @default(0)
  trackingNumber    String?
  estimatedDelivery DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reviews   Review[]

  @@index([userId])
  @@index([createdAt])
}

// Add indexes for better query performance
model OrderProduct {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId    String   @db.ObjectId
  productId  String   @db.ObjectId
  quantity   Int      @default(1)
  price      Float // Price at time of purchase
  isReviewed Boolean  @default(false)
  order      Order    @relation(fields: [orderId], references: [id])
  product    Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

// Update PaymentMethod enum
enum PaymentMethod {
  CARD
  CASH_ON_DELIVERY
}

// Add this model for Stripe webhook events
model StripeWebhookEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId   String   @unique
  type      String
  data      Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("stripe_webhook_events")
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

enum OrderStatus {
  PENDING
  DISPATCHED
  COMPLETED
  CANCELLED
  REFUNDED
}

model Review {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  rating     Int
  des        String  @default("")
  isApproved Boolean @default(false)

  userId    String @db.ObjectId
  orderId   String @db.ObjectId
  productId String @db.ObjectId

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  des          String
  images       String[]
  startDate    String
  endDate      String
  audienceSize String
  price        String
  status       EventStatus @default(UP_COMMING)

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  EventBooking EventBooking[]

  @@map("events")
}

enum EventStatus {
  UP_COMMING
  RUNNING
  COMPLETE
}

enum EventBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

model EventBooking {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  eventId   String  @db.ObjectId
  userId    String  @db.ObjectId
  paymentId String? @unique @db.ObjectId
  person    String  @default("1")

  // Booking details
  bookingDate DateTime           @default(now())
  status      EventBookingStatus @default(CONFIRMED)

  // Relations
  event   Event    @relation(fields: [eventId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id]) // Keep cascade here only

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@map("event_bookings")
}

// ========== CMS/Profile Management ==========

model hero {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  title    String? @default("")
  subTitle String? @default("")
  intro    String? @default("")
  image    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hero")
}

model OurStory {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  title    String? @default("")
  subTitle String? @default("")
  image    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("our_story")
}

model Blog {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  title    String
  subTitle String?  @default("")
  des      String
  images   String[]
  active   Boolean  @default(true)
  views    Int      @default(0)

  adminId   String   @db.ObjectId
  admin     User     @relation(fields: [adminId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blogs")
}

model socials {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  pinterest String @default("")
  linkedin  String @default("")
  instagram String @default("")
  facebook  String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("socials")
}
